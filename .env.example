# Application Configuration
APP_NAME=email-capture-landing-page
NODE_ENV=production  # MUST be 'production' on Vercel

# Security - CRITICAL: Change these values for production!
ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD  # Used for MinIO admin access
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET  # Not currently used but reserved for future auth

# Optional: AI Integration (not required for core functionality)
OPENROUTER_API_KEY=your_openrouter_key_here

# Database - OPTIONAL but RECOMMENDED
# The application works with Airtable alone, but having a database provides:
# - Duplicate detection for email subscriptions
# - Local data backup
# - Faster queries
# For Vercel deployment, use Vercel Postgres or an external provider (Neon, Supabase, Railway)
# DATABASE_URL=postgresql://user:password@host:port/database

# Airtable Integration - REQUIRED for all form submissions
# Get these from your Airtable account:
# 1. Personal Access Token: Account Settings > Developer hub > Personal access tokens
# 2. Base ID: From airtable.com/api after selecting your base
# 3. Table Names: Exact names of your tables in Airtable (case-sensitive!)
AIRTABLE_PERSONAL_ACCESS_TOKEN=patXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_CREATOR_TABLE_NAME="Creator Applications"
AIRTABLE_HOST_TABLE_NAME="Host Applications"
AIRTABLE_AMBASSADOR_TABLE_NAME="Ambassador Applications"
AIRTABLE_EMAIL_SUBSCRIBERS_TABLE_NAME="Email Subscribers"
AIRTABLE_HOST_LEADS_TABLE_NAME="Host Leads"
AIRTABLE_INITIAL_SIGNUPS_TABLE_NAME="Initial Signups"

# Optional: Base URL for CORS and link generation
# BASE_URL=https://your-domain.vercel.app
